# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Generated runtime state (large/transient; regenerate with tools/run_demo.sh)
demo_run/
*.db
*.blocked.json

# Analysis cube stores are always generated; the repository keeps no data.
run/cube/
*.zarr/
.cube/txn/

# Point-in-time training export outputs are fully regenerable.
run/training-demo/
cube-training-*/
training.sqlite
training.sqlite-wal
training.sqlite-shm

# Offline connected-source distribution outputs are fully regenerable.
run/distribution-demo/
distribution.sqlite
distribution.sqlite-wal
distribution.sqlite-shm
distribution-index.sqlite
distribution-index.sqlite-wal
distribution-index.sqlite-shm

# Keep the small committed demo dataset, ignore any locally regenerated
# large archives outside it.
.pytest_cache/
